SUB2API_IMAGE=sub2api-multinode:VERSION-COMMIT
BIND_HOST=127.0.0.1
SERVER_PORT=8080
AUTO_SETUP=false
RUN_MODE=standard
INSTANCE_ROLE=control
INSTANCE_ID=new-control
DRAIN_DELAY_SECONDS=0
SHUTDOWN_TIMEOUT_SECONDS=30
STOP_GRACE_PERIOD=45s
WIREGUARD_BIND_IP=10.20.0.1
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_VALUE
REDIS_PASSWORD=REPLACE_WITH_EXISTING_VALUE
JWT_SECRET=REPLACE_WITH_EXISTING_VALUE
TOTP_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE
