SUB2API_IMAGE=sub2api-multinode:VERSION-COMMIT
SUB2API_DATA_PATH=./data
BIND_HOST=127.0.0.1
SERVER_PORT=8080
AUTO_SETUP=false
RUN_MODE=standard
INSTANCE_ROLE=gateway
INSTANCE_ID=vmiss-us-01
TZ=Asia/Shanghai

DATABASE_HOST=10.20.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_DBNAME=sub2api
DATABASE_PASSWORD=REPLACE_WITH_EXISTING_VALUE
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5

REDIS_HOST=10.20.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_EXISTING_VALUE
REDIS_DB=0
REDIS_POOL_SIZE=128
REDIS_MIN_IDLE_CONNS=4

JWT_SECRET=REPLACE_WITH_EXISTING_VALUE
TOTP_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE
