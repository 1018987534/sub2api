SUB2API_IMAGE=sub2api-multinode:VERSION-COMMIT
BIND_HOST=127.0.0.1
SERVER_PORT=8080
AUTO_SETUP=false
RUN_MODE=standard
INSTANCE_ROLE=gateway
INSTANCE_ID=bwg-us-01
WIREGUARD_BIND_IP=10.20.0.1
TZ=Asia/Shanghai

# The application uses the local Compose service names. Remote application
# nodes continue to reach these services through the WireGuard-only relays.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_DBNAME=sub2api
DATABASE_PASSWORD=REPLACE_WITH_EXISTING_VALUE
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=64
DATABASE_MAX_IDLE_CONNS=16

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_EXISTING_VALUE
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=8

JWT_SECRET=REPLACE_WITH_EXISTING_VALUE
TOTP_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_VALUE
