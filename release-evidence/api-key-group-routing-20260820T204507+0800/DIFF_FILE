+func (s *APIKeyService) validateAPIKeyGroupRoutes(ctx context.Context, user *User, routes []APIKeyGroupRoute) ([]APIKeyGroupRoute, *Group, error) {
+	if len(routes) == 0 {
+		return []APIKeyGroupRoute{}, nil, nil
+	}
+	if len(routes) > maxAPIKeyGroupRoutes {
+		return nil, nil, fmt.Errorf("%w: at most %d groups are allowed", ErrAPIKeyGroupRoutesInvalid, maxAPIKeyGroupRoutes)
+	}
+
+	normalized := make([]APIKeyGroupRoute, 0, len(routes))
+	seen := make(map[int64]struct{}, len(routes))
+	var primary *Group
+	for i, route := range routes {
+		if route.GroupID <= 0 {
+			return nil, nil, fmt.Errorf("%w: group_id must be positive", ErrAPIKeyGroupRoutesInvalid)
+		}
+		if _, ok := seen[route.GroupID]; ok {
+			return nil, nil, fmt.Errorf("%w: duplicate group_id %d", ErrAPIKeyGroupRoutesInvalid, route.GroupID)
+		}
+		seen[route.GroupID] = struct{}{}
+		if route.MaxRateMultiplier != nil {
+			v := *route.MaxRateMultiplier
+			if math.IsNaN(v) || math.IsInf(v, 0) || v <= 0 {
+				return nil, nil, fmt.Errorf("%w: max_rate_multiplier must be a finite positive number", ErrAPIKeyGroupRoutesInvalid)
+			}
+			copyValue := v
+			route.MaxRateMultiplier = &copyValue
+		}
+
+		group, err := s.groupRepo.GetByID(ctx, route.GroupID)
+		if err != nil {
+			return nil, nil, fmt.Errorf("get route group %d: %w", route.GroupID, err)
+		}
+		if !group.IsActive() || !s.canUserBindGroup(ctx, user, group) {
