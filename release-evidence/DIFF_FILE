+func (s *LotteryService) UpdateProgress(ctx context.Context, roundID int64, participantCount int) (LotteryRound, error) {
+	tx, err := s.db.BeginTx(ctx, nil)
+	if err != nil {
+		return LotteryRound{}, err
+	}
+	defer func() { _ = tx.Rollback() }()
+
